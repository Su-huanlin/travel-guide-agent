# OpenAI-compatible API (国内兼容节点 / 国外 OpenAI 均可)
# 只要提供「聊天补全」接口：POST {base}/chat/completions

# --- 示例 A：DeepSeek（国内常用）---
# TG_API_KEY=sk-xxxx
# TG_BASE_URL=https://api.deepseek.com/v1
# TG_MODEL=deepseek-chat

# --- 示例 B：通义千问 DashScope 兼容模式 ---
# TG_API_KEY=sk-xxxx
# TG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TG_MODEL=qwen-plus

# --- 示例 C：Moonshot / Kimi ---
# TG_API_KEY=sk-xxxx
# TG_BASE_URL=https://api.moonshot.cn/v1
# TG_MODEL=moonshot-v1-128k

# --- 示例 D：OpenAI 官方 ---
# TG_API_KEY=sk-xxxx
# TG_BASE_URL=https://api.openai.com/v1
# TG_MODEL=gpt-4o-mini

# --- 示例 E：硅基流动 SiliconFlow ---
# TG_API_KEY=sk-xxxx
# TG_BASE_URL=https://api.siliconflow.cn/v1
# TG_MODEL=deepseek-ai/DeepSeek-V3

TG_API_KEY=
TG_BASE_URL=https://api.deepseek.com/v1
TG_MODEL=deepseek-chat

# 可选：温度与最大 token
TG_TEMPERATURE=0.3
TG_MAX_TOKENS=8192
